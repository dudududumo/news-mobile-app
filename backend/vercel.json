{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "uploads/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/posts(.*)",
      "dest": "/api/posts.js"
    },
    {
      "src": "/api/users(.*)",
      "dest": "/api/users.js"
    },
    {
      "src": "/api/analytics(.*)",
      "dest": "/api/analytics.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "404.html"
    }
  ]
}